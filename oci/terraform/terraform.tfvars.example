# ─── OCI Authentication Credentials ──────────────────────────────────────────
# 1. Tenancy OCID: OCI Console -> Tenancy Details
tenancy_ocid = "ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 2. User OCID: OCI Console -> Profile -> My Profile
user_ocid    = "ocid1.user.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 3. Fingerprint: Generated when you upload/generate your API Key in Profile -> API Keys
fingerprint  = "12:34:56:78:90:ab:cd:ef:12:34:56:78:90:ab:cd:ef"

# 4. Path to your downloaded .pem private key
private_key_path = "./oci_api_key.pem"

# 5. OCI Region (Must match your tenancy Home Region for Always Free resources)
region = "ap-mumbai-1"

# ─── SSH Key ──────────────────────────────────────────────────────────────────
# Your personal public SSH key (e.g. from ~/.ssh/id_ed25519.pub or id_rsa.pub)
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Optional: Restrict SSH to your IP for maximum security (e.g. ["203.0.113.50/32"])
# Default is open: ["0.0.0.0/0"]
ssh_allowed_cidrs = ["0.0.0.0/0"]

# ─── Project & Domain Settings ────────────────────────────────────────────────
project_name       = "share2me"
environment        = "prod"
frontend_domain    = "share2.me"
backend_domain     = "api.share2.me"
additional_domains = ["www.share2.me", "share2me.in", "www.share2me.in"]
acme_email         = "admin@share2.me"

# ─── Compute Specs (Always Free Ampere A1 Caps) ───────────────────────────────
instance_shape          = "VM.Standard.A1.Flex"
instance_ocpus          = 1    # 1 OCPU per VM (2 OCPUs total across 2 VMs is the Always Free limit)
instance_memory_in_gbs  = 6    # 6 GB RAM per VM (12 GB RAM total across 2 VMs is the Always Free limit)
boot_volume_size_in_gbs = 100  # Up to 200 GB across all volumes is Always Free

# ─── Application Secrets (Injected to .env on the server with chmod 600) ──────
# Metered TURN / ICE Server API Key
metered_api_key        = ""

# Stripe Payment Secrets
stripe_secret_key      = ""
stripe_webhook_secret  = ""

# Supabase PostgreSQL Connection URL
