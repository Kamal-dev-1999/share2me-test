# ─── Object Storage Namespace Data Source ─────────────────────────────────────
data "oci_objectstorage_namespace" "ns" {
  compartment_id = var.tenancy_ocid
}

# ─── S3-Compatible Blog Storage Bucket (Always Free: 10 GB) ───────────────────
# Replaces AWS S3 (share2me-auto-blogs-prod) and GCP Cloud Storage.
#
# SECURITY POSTURE:
# access_type is set strictly to "NoPublicAccess".
# No unauthenticated public user can read or list objects directly from OCI.
# The Express backend proxies images and blogs via authenticated API routes,
# preventing data leakage and scraping.
resource "oci_objectstorage_bucket" "blogs" {
  compartment_id = var.tenancy_ocid
  namespace      = data.oci_objectstorage_namespace.ns.namespace
  name           = "${var.project_name}-blogs-${var.environment}"

  # Strictly Private: Zero public access allowed
  access_type  = "NoPublicAccess"
  storage_tier = "Standard" # Standard tier is Always Free up to 10 GB
  versioning   = "Enabled"  # Protect against accidental overwrites

  freeform_tags = {
    "Project"     = var.project_name
    "Environment" = var.environment
    "Purpose"     = "AutoGeneratedBlogs"
    "ManagedBy"   = "Terraform"
  }
}

# (Lifecycle policy omitted — requires tenancy-level service principal IAM policy)
