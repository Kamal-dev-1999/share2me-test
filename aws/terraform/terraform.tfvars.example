# ─── terraform.tfvars.example ─────────────────────────────────────────────────
# Copy this file to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars to git — it contains sensitive data.
# The .gitignore already excludes *.tfvars files.

aws_region   = "ap-south-1"
environment  = "prod"
project_name = "share2me"

# ─── Networking ───────────────────────────────────────────────────────────────
vpc_cidr            = "10.0.0.0/16"
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]
availability_zones  = ["ap-south-1a", "ap-south-1b"]

# ─── EC2 ──────────────────────────────────────────────────────────────────────
ec2_instance_type = "t3.micro"
ec2_key_pair_name = "share2me-key"   # Create in EC2 → Key Pairs before applying

# ─── Container Resources ──────────────────────────────────────────────────────
# t3.micro budget: 2 vCPU, ~1024 MB RAM
# Caddy (64+64) + Frontend (256+256) + Backend (256+256) + Redis (128+128) = 704 CPU / 704 MB
frontend_cpu    = 256
frontend_memory = 256
backend_cpu     = 256
backend_memory  = 256

# ─── Application ──────────────────────────────────────────────────────────────
frontend_domain = "share2.me"
backend_domain  = "api.share2.me"
allowed_origins = "https://share2.me,https://www.share2.me"

# ─── TLS — Caddy Let's Encrypt ────────────────────────────────────────────────
# Your email is used by Let's Encrypt for cert expiry notifications only.
acme_email = "your-email@example.com"

# ─── Secrets (set via env var or SSM console, not committed here) ────────────
metered_api_key = "af1492ea038e29515f10a8a03404c9ce3b34"   
# Or: TF_VAR_metered_api_key=xxx terraform apply
google_analytics_id = "G-8XDS75JXYK"