# ─── Share2Me Production Caddyfile (Oracle Cloud Infrastructure) ──────────────
# Handles automatic TLS certificate issuance (Let's Encrypt / ZeroSSL)
# for all custom domains, and provides HTTP direct IP fallback for testing.
#
# Architecture:
#   Browser → Caddy (80/443) → frontend:3000 (Next.js)  [pages + /api/auth]
#                             → backend:8000  (Express)  [API + socket.io]
#
# URL hiding: all client traffic enters on share2.me only.
# Backend IP/host is never transmitted to the browser.

{
    email admin@share2.me
    servers {
        protocols h1 h2
    }
}

# ── Shared routing snippet — used by all three entry points ───────────────────
# Keeps IP-fallback and production domains in perfect sync (no drift).
(app_routes) {
    encode zstd gzip

    # Named matcher: paths that belong to the Express backend.
    # IMPORTANT: /api/auth/* is intentionally excluded — NextAuth lives on Next.js.
    # IMPORTANT: /g2p/nearby and /g2p/<code> are Next.js pages — excluded here.
    @backend path \
        /health*          \
        /ping*            \
        /metrics*         \
        /socket.io/*      \
        /api/ice-servers* \
        /api/blogs*       \
        /api/admin*       \
        /api/tools*       \
        /g2p/printshop*   \
        /g2p/requests*    \
        /g2p/files*       \
        /g2p/vendor*      \
        /g2p/billing*     \
        /g2p/tools*       \
        /g2p/health*      \
        /download/*       \
        /poc/*

    handle @backend {
        # Proxy over OCI private VCN to VM 2 (10.0.1.218:8000)
        reverse_proxy 10.0.1.218:8000 {
            # Caddy sets X-Forwarded-For automatically — do NOT override it
            # here or Cloudflare real-IP passthrough breaks in future.
            transport http {
                keepalive            30s
                keepalive_idle_conns 100
            }
        }
    }

    # Everything else → Next.js frontend.
    # Covers: /, all pages, /api/auth/* (NextAuth), /g2p/nearby, /g2p/<code>
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}

# ── Production HTTPS domains ──────────────────────────────────────────────────
# Caddy auto-provisions Let's Encrypt / ZeroSSL certs once DNS points here.
share2.me, www.share2.me, share2me.in, www.share2me.in {
    import app_routes

    header {
        # HSTS: 1 year, include subdomains.
        # NOTE: "preload" omitted — add only after all subdomains are on HTTPS permanently.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "strict-origin-when-cross-origin"
    }
}

# ── API subdomain — kept for backward compat with old cached bundles ──────────
# Once NEXT_PUBLIC_SIGNAL_URL is removed from the build and all clients use
# same-origin socket connections, this block can be turned into a redirect.
api.share2.me, api.share2me.in {
    reverse_proxy 10.0.1.218:8000 {
        transport http {
            keepalive            30s
            keepalive_idle_conns 100
        }
    }
}

# ── Direct IP fallback (HTTP :80) ─────────────────────────────────────────────
# http://130.210.22.28 for pre-DNS verification. Uses same routing as HTTPS.
:80 {
    import app_routes
}

