# Admin Portal Environment Variables

# Authorized Admin Emails (comma-separated allowlist)
AUTHORIZED_ADMIN_EMAILS=admin@share2.me,rishabh@share2.me,rishabhdev2026@gmail.com

# Shared Secret for Authorization Headers
AUTH_SECRET=your_super_secret_admin_token

# PostgreSQL Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/share2me

# Multi-site Deployment Webhooks & Tokens
SHARE2ME_DEPLOY_TOKEN=token_share2me_main
SHARE2ME_IN_DEPLOY_TOKEN=token_share2me_in
DEPLOY_WEBHOOK_SHARE2ME=https://share2.me/api/deploy-webhook
DEPLOY_WEBHOOK_SHARE2ME_IN=https://share2me.in/api/deploy-webhook
