# ─── Share2Me runtime configuration contract ───────────────────────────────────
# This is the canonical list of environment variables read by the code.
# Historical docs may mention NEXT_PUBLIC_SIGNAL_URL, R2_ENDPOINT or backend/db/;
# those names are NOT used by the current implementation.
# Copy to the appropriate .env file and replace every placeholder. NEVER commit.
# See docs/CONFIGURATION.md for deployment-specific details.

# ── Shared auth (must match across frontend and backend) ───────────────────────
# Canonical name. JWT_SECRET and AUTH_SECRET remain accepted aliases so older
# deployments keep working, but set only AUTH_JWT_SECRET going forward.
AUTH_JWT_SECRET=replace_with_a_long_random_value

# Frontend only: NextAuth v5 secret. Set it to the SAME value as AUTH_JWT_SECRET
# (or leave it unset and let AUTH_JWT_SECRET be used).
# AUTH_SECRET=replace_with_the_same_value

# Frontend only: Google OAuth
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
NEXTAUTH_URL=https://share2me.in

# Frontend only: backend location
# Local dev: http://localhost:3000
# Production behind Caddy: leave BACKEND_URL set at build time only; the browser
# resolves same-origin URLs via frontend/src/lib/backendUrl.ts.
BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_EXPRESS_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/share2me

# ── Cloudflare R2 (endpoint is derived from R2_ACCOUNT_ID) ─────────────────────
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET_NAME=replace_me

# ── Signaling / WebRTC ─────────────────────────────────────────────────────────
METERED_API_KEY=replace_me_or_leave_blank_for_google_stun_only
ALLOWED_ORIGINS=https://share2.me,https://www.share2.me,https://share2me.in,https://www.share2me.in

# ── Payments ───────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=replace_me
RAZORPAY_KEY_SECRET=replace_me
NEXT_PUBLIC_RAZORPAY_KEY_ID=replace_me
STRIPE_SECRET_KEY=replace_me
STRIPE_PRICE_ID=replace_me

# ── Email (bank/UPI OTP) ───────────────────────────────────────────────────────
SMTP_HOST=replace_me
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASS=replace_me

# ── Optional services ──────────────────────────────────────────────────────────
GEMINI_API_KEY=replace_me
# Optional: supported Gemini model name. Never rely on a silent downgrade.
GEMINI_MODEL=replace_me_or_leave_blank
ML_SERVICE_URL=http://127.0.0.1:8001/remove-background
INTERNAL_ML_SECRET=replace_me
POLLINATIONS_API_KEY=replace_me_or_leave_blank
REDIS_URL=redis://redis:6379

# ── Operations ─────────────────────────────────────────────────────────────────
# Required in production or /metrics returns 404.
METRICS_TOKEN=replace_me
# Emergency escape hatch only: disables upload signature verification.
# DISABLE_MAGIC_BYTE_CHECK=true

# ── Document rendering tools ───────────────────────────────────────────────────
# Chromium/Edge binary used by HTML→PDF and Markdown→PDF. Docker sets this already.
# CHROME_BIN=/usr/bin/chromium-browser
# Markdown→PDF limits (bytes, milliseconds).
# TOOLS_MD_MAX_BYTES=2097152
# TOOLS_PDF_TIMEOUT_MS=30000

# ── Analytics ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-8XDS75JXYK
