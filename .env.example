# ─── .env.example ─────────────────────────────────────────────────────────────
# Copy this to .env.local for local docker-compose development.
# .env.local is gitignored — NEVER commit actual secrets.

# Metered TURN server API key for ICE credential generation
# Get yours at: https://dashboard.metered.ca
METERED_API_KEY=your_metered_api_key_here

# Optional: internal metrics auth token
# METRICS_TOKEN=your_metrics_token_here

# (Optional) Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=G-8XDS75JXYK

